NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key   # server only, never expose

# Optional: enables AI answers in the Gia assistant (otherwise it uses built-in quick answers)
ANTHROPIC_API_KEY=your-anthropic-api-key
# ASSISTANT_MODEL=claude-opus-5-5

# Email notifications via Resend (https://resend.com) — every notification is also emailed
RESEND_API_KEY=re_xxxxxxxxx
EMAIL_FROM="People Success <no-reply@peoplesuccess.grevya.com>"
# EMAIL_REPLY_TO=hr@grevya.com
# Base URL for links in emails (defaults to the Vercel production domain)
# APP_URL=https://peoplesuccess.vercel.app
# Outside production, only these recipients get mail (comma-separated; *@domain allowed). Empty = nobody.
# EMAIL_DEV_ALLOWLIST=you@grevya.com
